{
  "mcpServers": {
    "desktop-commander": {
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx -y @wonderwhy-er/desktop-commander@latest"
      ]
    },
    "chrome-devtools": {
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "<USER_NPM_GLOBAL_ROOT>\\node_modules\\chrome-devtools-mcp\\out\\Default\\gen\\src\\bin\\chrome-devtools-mcp.js",
        "--autoConnect",
        "--usageStatistics=false",
        "--performanceCrux=false",
        "--redactNetworkHeaders=true",
        "--fileNavigations=false",
        "--backgroundNewPages=true",
        "--filesystemRoot=<USERPROFILE>\\AgentWorkstation\\workspace"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
